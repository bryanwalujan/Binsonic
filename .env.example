APP_NAME="BINSONIC–TERRA"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://gemastik.unima.space
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
# Only for the separate public-directory layout; use the actual absolute path.
# APP_PUBLIC_PATH=/home/CPANEL_USER/public_html/gemastik

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CPANEL_USER_binsonic_terra
DB_USERNAME=CPANEL_USER_monitor
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database
CACHE_PREFIX=binsonic_terra_
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

DEVICE_ONLINE_SECONDS=60
SENSOR_STALE_SECONDS=120
VITE_APP_NAME="${APP_NAME}"

# Display parameters only, NOT health or safety thresholds.
MQ7_TREND_WINDOW_SECONDS=300
MQ7_TREND_GAP_SECONDS=45
MQ7_TREND_MIN_SAMPLES_PER_HALF=3
MQ7_TREND_ABSOLUTE_DELTA=30
MQ7_TREND_RELATIVE_DELTA=0.05
